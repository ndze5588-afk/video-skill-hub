          "does": "把脚本转成配音，顺带生成背景音乐"
        },
        {
          "skill": "remotion",
          "does": "按配音时长排画面、动画和字幕"
        },
        {
          "skill": "ffmpeg-skill",
          "does": "响度标准化，导出横屏和竖屏两版"
        }
      ]
    },
    {
