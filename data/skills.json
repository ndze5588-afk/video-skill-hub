  "workflows": [
    {
      "id": "explainer",
      "name": "口播讲解视频",
      "summary": "写脚本、配音、用代码合成画面，最后按平台导出。全程不用打开剪辑软件。",
      "steps": [
        { "skill": "claude-youtube", "does": "按留存结构写脚本，标出画面切换点" },
        { "skill": "elevenlabs", "does": "把脚本转成配音，顺带生成背景音乐" },
        { "skill": "remotion", "does": "按配音时长排画面、动画和字幕" },
        { "skill": "ffmpeg-skill", "does": "响度标准化，导出横屏和竖屏两版" }
      ]
    },
    {
      "id": "promo",
      "name": "产品宣传短片",
      "summary": "先定分镜，再逐镜头生成画面，用 HTML 动效包装成片。",
      "steps": [
        { "skill": "storyboard", "does": "把需求拆成 6–8 个镜头，并写好每个镜头的提示词" },
        { "skill": "higgsfield", "does": "逐镜头生成视频素材和产品图" },
        { "skill": "hyperframes", "does": "加文字动效和转场，合成整片" },
        { "skill": "ffmpeg-skill", "does": "按抖音、YouTube、小红书的尺寸分别导出" }
      ]
    },
    {
      "id": "localize",
      "name": "视频出海本地化",
      "summary": "把一支中文视频变成多语言版本，配音对口型，字幕烧录进画面。",
      "steps": [
        { "skill": "whisper-transcription", "does": "转写原片，得到带时间轴的字幕" },
        { "skill": "heygen", "does": "翻译并克隆原声配音，对齐口型" },
        { "skill": "ffmpeg-captions", "does": "把目标语言字幕烧录进视频" }
      ]
    }
  ]
}
